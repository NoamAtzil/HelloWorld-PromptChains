# Same Supabase project as the public and admin apps. Only the public URL and
# anon key are needed: this app never uses a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
# Server-only run-signing secret (24+ chars). Must equal private.app_settings
# chain_run_secret in the database (see the migration header). Generate one with:
#   openssl rand -hex 32
CHAIN_RUN_SECRET=a-long-random-string-of-24-or-more-characters
